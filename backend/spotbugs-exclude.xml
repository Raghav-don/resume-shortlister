<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude test classes -->
    <Match>
        <Class name="~.*Test.*"/>
    </Match>
    <Match>
        <Class name="~.*Test"/>
    </Match>

    <!-- Exclude generated code -->
    <Match>
        <Class name="~.*MapperImpl"/>
    </Match>

    <!-- Exclude DTOs and entities (data classes) -->
    <Match>
        <Class name="~.*\.dto\..*"/>
    </Match>
    <Match>
        <Class name="~.*\.domain\..*"/>
    </Match>

    <!-- Exclude specific false positives -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>