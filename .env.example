# Resume Shortlister - Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/resume_shortlister
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# JWT Configuration (generate a secure base64-encoded secret)
# REQUIRED: Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend
VITE_API_URL=http://localhost:8080/api

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Redis (optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=